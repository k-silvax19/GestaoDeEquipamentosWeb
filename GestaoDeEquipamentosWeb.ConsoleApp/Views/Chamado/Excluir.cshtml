@{
    Layout = "_Layout";
    ViewBag.Titulo = "Exclusão De Chamados";

    List<SelectListItem> selecionarEquipamentos = ViewBag.Equipamentos;
}

@model ExcluirChamadoViewModel

<form class="formulario" asp-action="Excluir" asp-route-id="@Model.Id" method="post">

    <div class="formulario-campo">
        <label asp-for="Titulo">Título</label>
        <input asp-for="Titulo" type="text" disabled>
        <span asp-validation-for="Titulo" class="formulario-validação-campo"></span>
    </div>

    <div class="formulario-campo">
        <label asp-for= "Descricao">Descrição</label>
        <textarea asp-for= "Descricao" disabled></textarea>
        <span asp-validation-for="Descricao"  class="formulario-validação-campo"></span>
        
    </div>
 
   <div class="formulario-campo">
        <label asp-for="Equipamento">Equipamento</label>
        <select asp-for="Equipamento" asp-items="selecionarEquipamentos" ></select>
            <option value="">Selecione um Equipamento</option>
            
        <span asp-validation-for="Equipamento" class="formulario-validação-campo"></span>
    </div>

    <div class ="formulario-acoes">
        <a asp-action="Listar"">Voltar</a>
        <button type="submit">Confirmar</button>
    </div>
</form>