@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem De Fabricantes";
}

@using GestaoDeEquipamentosWeb.ConsoleApp.Models;

@model List<ListarFabricanteViewModel>

<a class= "btn-cadastrar" href="/Fabricante/Cadastrar">Cadastrar novo</a>

<table class ="registros">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nome</th>
            <th>Email</th>
            <th>Telefone</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (ListarFabricanteViewModel f in Model)
        {
            <tr>
                <td>@f.Id</td>
                <td>@f.Nome</td>
                <td>@f.Email</td>
                <td>@f.Telefone</td>
                <td>
                    <a href="/Fabricante/Editar/@f.Id">Editar</a>
                    <a href="/Fabricante/Excluir/@f.Id">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>

